<?xml version="1.0" encoding="UTF-8"?>
<!--
  MAIDR Accessible Charts: the Office add-in MAIDR publishes, for Excel,
  PowerPoint and Word. See docs/office-addin.md for installing it, and
  addin/README.md for how it is built and served.

  Every URL is on https://maidr.ai/addin/, where the documentation site
  serves this folder (scripts/build-site.js). The task pane loads MAIDR from
  the same site's dist/ and calls maidrOffice.bindOffice, which reads Excel's
  charts through Office.js and PowerPoint's and Word's from the file.

  ReadWriteDocument, although the pane writes nothing: Office requires it of
  any add-in that uses the Excel, PowerPoint or Word JavaScript API.

  No Requirements element, on purpose: an Office too old to share its charts
  still opens the add-in, and the pane says why it cannot read them, rather
  than the add-in going missing with no word why.

  Change the Version whenever this file changes, as Office and the Microsoft
  Marketplace require. Keep the Id: it is the add-in's identity everywhere it
  has been installed.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>47f6c582-a750-4bb0-b73e-2cb775cc0d1b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>xability</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="MAIDR Accessible Charts" />
  <Description DefaultValue="Hear, read in braille and explore with the keyboard the charts in your workbook, presentation or document: sonification, text descriptions and braille for blind and low-vision readers." />
  <IconUrl DefaultValue="https://maidr.ai/addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://maidr.ai/addin/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://maidr.ai/office-addin.html" />
  <Hosts>
    <Host Name="Workbook" />
    <Host Name="Presentation" />
    <Host Name="Document" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://maidr.ai/addin/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Maidr.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="Maidr.ShowTaskpane">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Maidr.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Maidr.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="Maidr.ShowTaskpane">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Maidr.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Maidr.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="Maidr.ShowTaskpane">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Maidr.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://maidr.ai/addin/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://maidr.ai/addin/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://maidr.ai/addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://maidr.ai/office-addin.html" />
        <bt:Url id="Commands.Url" DefaultValue="https://maidr.ai/addin/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://maidr.ai/addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="MAIDR Accessible Charts is ready" />
        <bt:String id="Group.Label" DefaultValue="MAIDR" />
        <bt:String id="Button.Label" DefaultValue="Accessible Charts" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="On the Home tab, select Accessible Charts to hear, read in braille and explore the charts in this file with the keyboard." />
        <bt:String id="Button.Tooltip" DefaultValue="Open MAIDR in a pane beside the file, to hear, read in braille and explore its charts with the keyboard." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
