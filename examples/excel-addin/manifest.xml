<?xml version="1.0" encoding="UTF-8"?>
<!--
  MAIDR as an Excel task pane add-in, for development. See README.md.

  Every URL is https://localhost:3000, where the README serves this
  repository from. Excel loads a task pane only over https, so the server
  needs a certificate Excel trusts. To use it from anywhere else, host
  taskpane.html and the built dist/maidr.js and dist/excel.js yourself and
  change SourceLocation.

  ReadWriteDocument, although the pane writes nothing: Office requires it of
  any add-in that uses the Excel JavaScript API, even one that only reads.

  No Requirements element, on purpose. Reading a chart needs ExcelApi 1.12;
  declaring it would hide the add-in from an older Excel altogether, where
  leaving it out lets the pane open there and say why it cannot read.

  No add-in commands (VersionOverrides) and no icons: Excel opens the task
  pane as soon as the add-in is added. Give a copy of this file its own Id
  before you build on it.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>aeaa56ef-f90e-4487-a705-0fd842fa6cda</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>xability</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="MAIDR accessible charts" />
  <Description DefaultValue="Audio sonification, text descriptions, braille and keyboard navigation for the charts in this workbook, for blind and low-vision readers." />
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/examples/excel-addin/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
